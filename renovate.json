{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays",
    ":dependencyDashboard"
  ],
  "enabledManagers": ["github-actions", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.pkr\\.hcl$/"],
      "matchStrings": [
        "required_version[\\s]+=[\\s]+\"=?(?<currentValue>\\S*)\"",
        "source[\\s]+=[\\s]+\"github.com/(?<depName>\\S*)\"[\\s]+version[\\s]+=[\\s]+\"(?<currentValue>\\S*)\"",
        "version[\\s]+=[\\s]+\"(?<currentValue>\\S*)[\\s]+source[\\s]+=[\\s]+\"github.com/(?<depName>\\S*)\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "{{#if depName}}{{#if (containsString depName \"hashicorp/\")}}{{{replace \"hashicorp/\" \"hashicorp/packer-plugin-\" depName}}}{{else}}{{{depName}}}{{/if}}{{else}}hashicorp/packer{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/scripts/bootstrap\\.sh$/"],
      "matchStrings": [
        "https://github.com/(?<depName>strongtz/i915-sriov-dkms)/releases/download/(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["github-releases"],
      "groupName": "packer-plugins"
    }
  ]
}
